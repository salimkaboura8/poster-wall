# Get a free key at https://www.themoviedb.org/settings/api
# Use EITHER the v4 "API Read Access Token" (recommended) OR the v3 "API Key".
VITE_TMDB_READ_TOKEN=
VITE_TMDB_API_KEY=

# Optional: where the deployed site reads Letterboxd RSS feeds (no CORS on letterboxd.com).
# Dev and `npm run preview` use the built-in /letterboxd proxy, so leave this empty locally.
# VITE_LETTERBOXD_PROXY=https://your-proxy.example.com
